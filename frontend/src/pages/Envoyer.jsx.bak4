import { useRef, useState } from 'react'
import { useNavigate } from 'react-router-dom'
import { Paperclip, SendHorizontal, User, Users, X, Info, Bold, Italic, List } from 'lucide-react'
import api from '../api'
import { useMessagerie } from '../MessagerieContext'
import { messageErreur, tailleLisible } from '../utils'
import { Bouton, Carte } from '../components/ui'
import SelecteurDestinataires from '../components/SelecteurDestinataires'

const TYPES_ACCEPTES = '.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.odt,.ods,.txt,.csv,.png,.jpg,.jpeg,.gif,.webp'
const MAX_FICHIERS = 5
const MAX_OCTETS = 10 * 1024 * 1024

export default function Envoyer() {
  const navigate = useNavigate()
  const { recharger } = useMessagerie()

  const [choisis, setChoisis] = useState([])
  const [texte, setTexte] = useState('')
  const [fichiers, setFichiers] = useState([])
  const [envoi, setEnvoi] = useState(false)
  const [erreur, setErreur] = useState('')

  const textareaRef = useRef(null)

  const mode = choisis.length === 0 ? null : choisis.length === 1 ? 'DIRECT' : 'MULTIPLE'
  const pret = choisis.length >= 1 && (texte.trim() !== '' || fichiers.length > 0)

  function changerDestinataires(liste) {
    setChoisis(liste)
  }

  function ajouterFichiers(e) {
    const nouveaux = Array.from(e.target.files)
    e.target.value = ''
    const total = [...fichiers, ...nouveaux]
    if (total.length > MAX_FICHIERS) {
      setErreur(`${MAX_FICHIERS} fichiers maximum par message.`)
      return
    }
    const trop = total.find((f) => f.size > MAX_OCTETS)
    if (trop) {
      setErreur(`${trop.name} dépasse 10 Mo.`)
      return
    }
    setErreur('')
    setFichiers(total)
  }

  // Insertion de markdown autour de la sélection
  function insererMarkdown(avant, apres = '') {
    const ta = textareaRef.current
    if (!ta) return
    const debut = ta.selectionStart
    const fin = ta.selectionEnd
    const selection = texte.substring(debut, fin) || 'texte'
    const nouveauTexte =
      texte.substring(0, debut) +
      avant + selection + apres +
      texte.substring(fin)
    setTexte(nouveauTexte)
    // Replace le curseur après l'insertion
    requestAnimationFrame(() => {
      ta.focus()
      ta.setSelectionRange(debut + avant.length, debut + avant.length + selection.length)
    })
  }

  async function envoyer(e) {
    e.preventDefault()
    if (!pret) return
    setEnvoi(true)
    setErreur('')

    try {
      const { data } = await api.post('/api/conversations', {
        participants: choisis.map((p) => p.matricule),
        message: texte.trim() || '(pièce jointe)',
      })

      if (fichiers.length > 0) {
        const conversations = data.type === 'DIRECT' ? [data.conversation] : data.conversations
        for (const conv of conversations) {
          const form = new FormData()
          fichiers.forEach((f) => form.append('fichiers[]', f))
          await api.post(`/api/conversations/${conv.reference_conversation}/messages`, form)
        }
      }

      await recharger()

      if (data.type === 'DIRECT') {
        navigate(`/conversations/${data.conversation.reference_conversation}`)
      } else {
        navigate('/conversations')
      }
    } catch (err) {
      setErreur(messageErreur(err))
      setEnvoi(false)
    }
  }

  return (
    <form onSubmit={envoyer} className="w-full px-6 py-6 md:px-8">
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">

        {/* ========== Colonne principale ========== */}
        <div className="lg:col-span-2 space-y-6">

          {/* Carte : Destinataires */}
          <Carte className="p-6">
            <div className="flex items-center justify-between mb-4">
              <h2 className="text-sm font-bold text-slate-900">
                Destinataire{choisis.length > 1 ? 's' : ''}
              </h2>
              {choisis.length > 0 && (
                <span className="text-xs font-medium text-slate-500">
                  {choisis.length} sélectionné{choisis.length > 1 ? 's' : ''}
                </span>
              )}
            </div>

            <SelecteurDestinataires
              direct={false}
              choisis={choisis}
              onChange={changerDestinataires}
            />
          </Carte>

          {/* Carte : Message (espace augmenté) */}
          <Carte className="p-6 mt-8">
            <h2 className="text-sm font-bold text-slate-900 mb-4">Message</h2>

            {/* Barre d'outils markdown */}
            <div className="flex items-center gap-1 border-b border-slate-200 pb-2 mb-2">
              <button
                type="button"
                onClick={() => insererMarkdown('**', '**')}
                className="rounded-md p-1.5 text-slate-500 hover:bg-slate-100 hover:text-slate-900 transition"
                aria-label="Gras"
                title="Gras"
              >
                <Bold className="size-4" />
              </button>
              <button
                type="button"
                onClick={() => insererMarkdown('*', '*')}
                className="rounded-md p-1.5 text-slate-500 hover:bg-slate-100 hover:text-slate-900 transition"
                aria-label="Italique"
                title="Italique"
              >
                <Italic className="size-4" />
              </button>
              <button
                type="button"
                onClick={() => insererMarkdown('- ', '\n')}
                className="rounded-md p-1.5 text-slate-500 hover:bg-slate-100 hover:text-slate-900 transition"
                aria-label="Liste"
                title="Liste à puces"
              >
                <List className="size-4" />
              </button>
              <span className="ml-2 text-[10px] text-slate-400 font-medium">
                Formatage markdown
              </span>
            </div>

            <textarea
              ref={textareaRef}
              value={texte}
              onChange={(e) => setTexte(e.target.value)}
              rows={6}
              maxLength={5000}
              placeholder="Écrivez votre message…"
              aria-label="Message"
              className="w-full resize-none rounded-lg border-0 bg-white px-1 py-2 text-sm
                         text-slate-900 placeholder-slate-400
                         focus:outline-none transition"
            />

            {/* Fichiers joints */}
            {fichiers.length > 0 && (
              <ul className="mt-3 flex flex-wrap gap-2">
                {fichiers.map((f, i) => (
                  <li key={`${f.name}-${i}`}>
                    <button
                      type="button"
                      onClick={() => setFichiers(fichiers.filter((_, j) => j !== i))}
                      className="flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs hover:bg-slate-100 transition"
                    >
                      <Paperclip className="size-3.5" />
                      <span className="truncate max-w-[180px]">{f.name}</span>
                      <span className="text-slate-400">({tailleLisible(f.size)})</span>
                      <X className="size-3.5" />
                    </button>
                  </li>
                ))}
              </ul>
            )}

            <div className="mt-3 flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-slate-100">
              <label className="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 transition">
                <Paperclip className="size-4" />
                Joindre des fichiers
                <input type="file" multiple accept={TYPES_ACCEPTES} onChange={ajouterFichiers} hidden />
              </label>
              <p className="text-xs text-slate-400">
                {fichiers.length} / {MAX_FICHIERS} fichiers · 10 Mo max · {texte.length} / 5000
              </p>
            </div>
          </Carte>

          {/* Erreur */}
          {erreur && (
            <p className="rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700" role="alert">
              {erreur}
            </p>
          )}

          {/* Actions */}
          <div className="flex justify-end gap-3">
            <Bouton onClick={() => navigate(-1)} disabled={envoi}>
              Annuler
            </Bouton>
            <button
              type="submit"
              disabled={!pret || envoi}
              className="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white
                         hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-500/20
                         disabled:opacity-50 disabled:cursor-not-allowed transition shadow-sm"
            >
              <SendHorizontal className="size-4" />
              {envoi
                ? 'Envoi…'
                : choisis.length <= 1
                  ? 'Envoyer'
                  : `Envoyer à ${choisis.length} personnes`}
            </button>
          </div>
        </div>

        {/* ========== Colonne latérale ========== */}
        <aside className="lg:sticky lg:top-6 space-y-4 self-start">

          {mode ? (
            <div className="rounded-2xl border border-indigo-200 bg-indigo-50/50 p-5">
              <div className="flex items-center gap-2 mb-3">
                {mode === 'DIRECT' ? (
                  <User className="size-4 text-indigo-600" />
                ) : (
                  <Users className="size-4 text-indigo-600" />
                )}
                <span className="text-xs font-bold uppercase tracking-wider text-indigo-900">
                  Mode détecté
                </span>
              </div>
              <p className="text-base font-bold text-indigo-900 mb-2">
                {mode === 'DIRECT' ? 'Message direct' : 'Envoi multiple'}
              </p>
              <p className="text-xs text-indigo-800/80 leading-relaxed">
                {mode === 'DIRECT'
                  ? 'Vous discutez en privé avec 1 personne. Une conversation existante sera utilisée si possible.'
                  : `Le message sera envoyé individuellement à ${choisis.length} personnes. Chacune pourra vous répondre dans sa propre conversation.`}
              </p>
            </div>
          ) : (
            <div className="rounded-2xl border border-slate-200 bg-white p-5">
              <div className="flex items-start gap-2">
                <Info className="size-4 text-slate-400 mt-0.5 flex-shrink-0" />
                <div>
                  <p className="text-sm font-bold text-slate-900">Mode automatique</p>
                  <p className="mt-1 text-xs text-slate-500 leading-relaxed">
                    Le type de conversation est déterminé par le nombre de destinataires :
                  </p>
                  <ul className="mt-3 space-y-1.5 text-xs text-slate-600">
                    <li className="flex items-center gap-2">
                      <span className="size-1.5 rounded-full bg-slate-400"></span>
                      <span><span className="font-semibold text-slate-800">1 personne</span> → Message direct</span>
                    </li>
                    <li className="flex items-center gap-2">
                      <span className="size-1.5 rounded-full bg-slate-400"></span>
                      <span><span className="font-semibold text-slate-800">2+ personnes</span> → Envoi multiple</span>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          )}

          <div className="rounded-2xl border border-slate-200 bg-slate-50 p-5">
            <p className="text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-2">
              💡 Bon à savoir
            </p>
            <p className="text-xs text-slate-600 leading-relaxed">
              Pour créer une <span className="font-semibold text-slate-900">discussion de groupe</span> (3 personnes minimum, tout le monde peut écrire), utilisez le bouton{' '}
              <span className="font-semibold text-slate-900">Nouveau groupe</span> depuis la page Conversations.
            </p>
          </div>
        </aside>
      </div>
    </form>
  )
}
