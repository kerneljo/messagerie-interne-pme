import { useEffect, useMemo, useState } from 'react'
import {
  Search,
  Building2,
  Mail,
  MessageSquare,
  Users,
  X,
} from 'lucide-react'
import { useNavigate } from 'react-router-dom'
import api from '../api'
import { useAuth } from '../AuthContext'
import useDebounce from '../useDebounce'
import { Avatar, Chargement, EtatVide } from '../components/ui'

const LIMITE = 200
const MIN_RECHERCHE = 2

export default function Annuaire() {
  const { utilisateur } = useAuth()
  const navigate = useNavigate()

  const [chargement, setChargement] = useState(true)
  const [recherche, setRecherche] = useState('')
  const [filtreService, setFiltreService] = useState('')
  const [services, setServices] = useState([])
  const [resultats, setResultats] = useState([])
  const rechercheDebouncee = useDebounce(recherche, 300)

  // Charge la liste des services une fois
  useEffect(() => {
    api
      .get('/api/annuaire/services')
      .then(({ data }) => setServices(data || []))
      .catch(() => setServices([]))
  }, [])

  // Charge la liste dès l'arrivée sur la page, puis à chaque recherche / filtre
  useEffect(() => {
    let annule = false
    setChargement(true)

    const terme = rechercheDebouncee.trim()
    const params = {
      q: terme.length >= MIN_RECHERCHE ? terme : undefined,
      code_service: filtreService || undefined,
      limite: LIMITE,
    }

    api
      .get('/api/annuaire', { params })
      .then(({ data }) => {
        if (!annule) setResultats(data || [])
      })
      .catch(() => {
        if (!annule) setResultats([])
      })
      .finally(() => {
        if (!annule) setChargement(false)
      })

    return () => {
      annule = true
    }
  }, [rechercheDebouncee, filtreService])

  // Groupe les résultats par service
  const groupes = useMemo(() => {
    const map = new Map()
    for (const u of resultats) {
      const cle = u.service || 'Autre'
      if (!map.has(cle)) map.set(cle, [])
      map.get(cle).push(u)
    }
    return Array.from(map.entries()).sort(([a], [b]) => a.localeCompare(b))
  }, [resultats])

  function effacerFiltres() {
    setRecherche('')
    setFiltreService('')
  }

  const aDesFiltres = recherche || filtreService

  return (
    <div className="mx-auto max-w-6xl p-4 md:p-6">
      {/* ===== En-tête ===== */}
      <div className="mb-6">
        <h2 className="text-2xl font-bold text-slate-900">Annuaire</h2>
        <p className="mt-1 text-sm text-slate-500">
          Trouvez un collègue et démarrez une conversation en un clic.
        </p>
      </div>

      {/* ===== Filtres ===== */}
      <div className="mb-6 flex flex-col gap-3 sm:flex-row">
        <div className="relative flex-1">
          <Search className="pointer-events-none absolute left-3.5 top-1/2 size-4 -translate-y-1/2 text-slate-400" />
          <input
            type="text"
            value={recherche}
            onChange={(e) => setRecherche(e.target.value)}
            placeholder="Rechercher par nom, prénom, email, poste…"
            className="w-full rounded-xl border border-slate-200 bg-white py-3 pl-10 pr-4 text-sm text-slate-800 placeholder-slate-400 shadow-sm transition focus:border-indigo-400 focus:outline-none focus:ring-4 focus:ring-indigo-500/15"
          />
          {recherche && (
            <button
              type="button"
              onClick={() => setRecherche('')}
              className="absolute right-3 top-1/2 -translate-y-1/2 rounded-md p-1 text-slate-400 hover:bg-slate-100 hover:text-slate-700"
              aria-label="Effacer la recherche"
            >
              <X className="size-4" />
            </button>
          )}
        </div>

        <select
          value={filtreService}
          onChange={(e) => setFiltreService(e.target.value)}
          className="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-800 shadow-sm transition focus:border-indigo-400 focus:outline-none focus:ring-4 focus:ring-indigo-500/15 sm:w-64"
        >
          <option value="">Tous les services</option>
          {services.map((s) => (
            <option key={s.code_service} value={s.code_service}>
              {s.nom_service} ({s.nb_utilisateurs})
            </option>
          ))}
        </select>

        {aDesFiltres && (
          <button
            type="button"
            onClick={effacerFiltres}
            className="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-600 transition hover:bg-slate-50"
          >
            Réinitialiser
          </button>
        )}
      </div>

      {/* ===== Contenu ===== */}
      {chargement ? (
        <Chargement />
      ) : resultats.length === 0 ? (
        <EtatVide icone={Users} titre={aDesFiltres ? 'Aucun résultat' : 'Aucun collaborateur'}>
          {aDesFiltres
            ? 'Essayez un autre nom ou un autre service.'
            : "Aucun autre compte actif n'est enregistré pour le moment."}
        </EtatVide>
      ) : (
        <>
          <p className="mb-4 text-sm text-slate-500" aria-live="polite">
            {resultats.length} {resultats.length > 1 ? 'collaborateurs' : 'collaborateur'}
          </p>

          <div className="space-y-6">
            {groupes.map(([service, membres]) => (
              <section key={service}>
                <header className="mb-3 flex items-center gap-2">
                  <Building2 className="size-4 text-slate-400" />
                  <h3 className="text-xs font-bold uppercase tracking-wider text-slate-500">
                    {service}
                  </h3>
                  <span className="text-xs text-slate-400">
                    {membres.length} {membres.length > 1 ? 'personnes' : 'personne'}
                  </span>
                </header>

                <ul className="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
                  {membres.map((u) => (
                    <CarteUtilisateur
                      key={u.matricule}
                      utilisateur={u}
                      estMoi={u.matricule === utilisateur?.matricule}
                      onMessage={() => navigate(`/conversations?nouvelle=1&destinataire=${u.matricule}`)}
                    />
                  ))}
                </ul>
              </section>
            ))}
          </div>

          {resultats.length >= LIMITE && (
            <p className="mt-6 text-sm text-slate-500">
              Affichage limité aux {LIMITE} premiers résultats. Affinez la recherche pour en voir plus.
            </p>
          )}
        </>
      )}
    </div>
  )
}

/* ============================================================
   Carte utilisateur
   ============================================================ */
function CarteUtilisateur({ utilisateur, estMoi, onMessage }) {
  return (
    <li className="group flex items-center gap-3 rounded-2xl border border-slate-200/70 bg-white p-3 shadow-sm transition hover:border-slate-300 hover:shadow-md">
      <Avatar
        prenom={utilisateur.prenom}
        nom={utilisateur.nom}
        photoUrl={utilisateur.photo_url}
        taille="md"
      />

      <div className="min-w-0 flex-1">
        <p className="truncate text-sm font-semibold text-slate-900">
          {utilisateur.prenom} {utilisateur.nom}
          {estMoi && <span className="ml-2 text-xs text-slate-400">(vous)</span>}
        </p>
        <p className="truncate text-xs text-slate-500">
          {utilisateur.poste || '—'}
        </p>
      </div>

      <div className="flex shrink-0 items-center gap-1">
        <a
          href={`mailto:${utilisateur.email}`}
          className="rounded-lg p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
          aria-label={`Envoyer un email à ${utilisateur.prenom} ${utilisateur.nom}`}
          title={utilisateur.email}
          onClick={(e) => e.stopPropagation()}
        >
          <Mail className="size-4" />
        </a>

        {!estMoi && (
          <button
            type="button"
            onClick={onMessage}
            className="rounded-lg p-2 text-lagon-800 transition hover:bg-lagon-800/10"
            aria-label={`Envoyer un message à ${utilisateur.prenom} ${utilisateur.nom}`}
            title="Envoyer un message"
          >
            <MessageSquare className="size-4" />
          </button>
        )}
      </div>
    </li>
  )
}
