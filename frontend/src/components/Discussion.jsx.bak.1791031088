import { Fragment, useCallback, useEffect, useRef, useState } from 'react'
import { motion, AnimatePresence } from 'framer-motion'
import {
  ArrowLeft, Check, CheckCheck, Paperclip, Pencil, Reply, SendHorizontal,
  Trash2, X, MoreHorizontal, Pin, Copy, Smile,
} from 'lucide-react'
import { Link } from 'react-router-dom'
import api from '../api'
import { useAuth } from '../AuthContext'
import usePolling from '../usePolling'
import { heureSeule, libelleJour, messageErreur, tailleLisible } from '../utils'
import { Avatar, Bouton } from './ui'
import EmojiPicker from './EmojiPicker'

const TYPES_ACCEPTES = '.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.odt,.ods,.txt,.csv,.png,.jpg,.jpeg,.gif,.webp'
const MAX_FICHIERS = 5
const MAX_OCTETS = 10 * 1024 * 1024
const REACTIONS_RAPIDES = ['👍', '❤️', '😂', '🔥', '😮', '😢']
const MAX_REACTIONS_PAR_USER = 3

function fusionner(anciens, nouveaux) {
  if (nouveaux.length === 0) return []
  const min = nouveaux[0].reference_message
  return [...anciens.filter((m) => m.reference_message < min), ...nouveaux]
}

/* ============================================================
   Animation Telegram-style
   ============================================================ */
function BulleAnimee({ children }) {
  return (
    <motion.div
      layout
      initial={{ opacity: 0, y: 12, scale: 0.97 }}
      animate={{ opacity: 1, y: 0, scale: 1 }}
      exit={{
        opacity: 0,
        height: 0,
        marginTop: 0,
        marginBottom: 0,
        paddingTop: 0,
        paddingBottom: 0,
        transition: { duration: 0.28, ease: [0.4, 0, 0.2, 1] },
      }}
      transition={{
        duration: 0.3,
        ease: [0.4, 0, 0.2, 1],
        layout: { duration: 0.28, ease: [0.4, 0, 0.2, 1] },
      }}
      style={{ overflow: 'visible' }}
    >
      {children}
    </motion.div>
  )
}

/* ============================================================
   Barre de réactions rapides (au-dessus de la bulle)
   ============================================================ */
function BarreReactions({ onReagir, position = 'above', align = 'right' }) {
  const estAuDessus = position === 'above'

  return (
    <motion.div
      initial={{ opacity: 0, scale: 0.9, y: estAuDessus ? 4 : -4 }}
      animate={{ opacity: 1, scale: 1, y: 0 }}
      exit={{ opacity: 0, scale: 0.9, y: estAuDessus ? 4 : -4 }}
      transition={{ duration: 0.15, ease: [0.4, 0, 0.2, 1] }}
      className={`absolute z-30 flex items-center gap-0.5 rounded-full border border-slate-200 bg-white px-1.5 py-1 shadow-lg shadow-slate-900/10 ${
        estAuDessus ? '-top-12' : 'top-full mt-2'
      } ${align === 'right' ? 'right-0' : 'left-0'}`}
    >
      {REACTIONS_RAPIDES.map((emoji) => (
        <button
          key={emoji}
          type="button"
          onClick={() => onReagir(emoji)}
          className="flex size-8 items-center justify-center rounded-full text-base transition-transform hover:scale-125 hover:bg-slate-100 active:scale-95"
          title={`Réagir ${emoji}`}
        >
          {emoji}
        </button>
      ))}
      <div className="mx-0.5 h-5 w-px bg-slate-200"></div>
      <button
        type="button"
        onClick={onReagir.bind(null, null, true)}
        className="flex size-8 items-center justify-center rounded-full text-slate-500 hover:bg-slate-100 hover:text-slate-700 transition"
        title="Plus d'emojis"
      >
        <Smile className="size-4" />
      </button>
    </motion.div>
  )
}

/* ============================================================
   Réactions collées à la bulle
   ============================================================ */
function ReactionsAffichees({ reactions, moi, onToggle }) {
  if (!reactions || reactions.length === 0) return null

  const visible = reactions.slice(0, 3)
  const masquees = reactions.length - visible.length

  return (
    <div className={`-mt-2 flex flex-wrap gap-1 z-10 relative ${moi ? 'justify-end pr-2' : 'justify-start pl-2'}`}>
      {visible.map((r) => (
        <button
          key={r.emoji}
          type="button"
          onClick={() => onToggle?.(r.emoji)}
          className={`inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-xs shadow-sm transition-all hover:scale-105 ${
            r.moi
              ? 'border-blue-300 bg-blue-50 text-blue-700 ring-1 ring-blue-100'
              : 'border-slate-200 bg-white text-slate-700 hover:bg-slate-50'
          }`}
          title={r.moi ? 'Retirer ma réaction' : `Réagir avec ${r.emoji}`}
        >
          <span className="text-sm leading-none">{r.emoji}</span>
          <span className="text-[10px] font-bold leading-none">{r.nb}</span>
        </button>
      ))}
      {masquees > 0 && (
        <span className="inline-flex items-center rounded-full border border-slate-200 bg-white px-2 py-0.5 text-[10px] font-bold text-slate-500">
          +{masquees}
        </span>
      )}
    </div>
  )
}

/* ============================================================
   Menu contextuel Telegram
   ============================================================ */
function MenuMessage({ moi, onRepondre, onModifier, onSupprimer, onFermer }) {
  const menuRef = useRef(null)

  useEffect(() => {
    function handler(e) {
      if (menuRef.current && !menuRef.current.contains(e.target)) onFermer()
    }
    document.addEventListener('mousedown', handler)
    return () => document.removeEventListener('mousedown', handler)
  }, [onFermer])

  return (
    <motion.div
      ref={menuRef}
      initial={{ opacity: 0, scale: 0.95, y: -4 }}
      animate={{ opacity: 1, scale: 1, y: 0 }}
      exit={{ opacity: 0, scale: 0.95, y: -4 }}
      transition={{ duration: 0.15, ease: [0.4, 0, 0.2, 1] }}
      className={`absolute top-full mt-2 z-30 w-52 rounded-2xl border border-slate-200 bg-white shadow-2xl shadow-slate-900/15 overflow-hidden ${
        moi ? 'right-0' : 'left-0'
      }`}
    >
      <div className="py-1">
        <ItemMenu icone={Reply} label="Répondre" onClick={() => { onRepondre(); onFermer() }} />
        {moi && <ItemMenu icone={Pencil} label="Modifier" onClick={() => { onModifier(); onFermer() }} />}
        <ItemMenu icone={Pin} label="Épingler" onClick={onFermer} />
        <ItemMenu icone={Copy} label="Copier le texte" onClick={onFermer} />
        {moi && (
          <>
            <div className="my-1 h-px bg-slate-100" />
            <ItemMenu icone={Trash2} label="Supprimer" onClick={() => { onSupprimer(); onFermer() }} danger />
          </>
        )}
      </div>
    </motion.div>
  )
}

function ItemMenu({ icone: Icone, label, onClick, danger }) {
  return (
    <button
      type="button"
      onClick={onClick}
      className={`w-full flex items-center gap-3 px-4 py-2.5 text-left text-sm transition ${
        danger ? 'text-red-600 hover:bg-red-50' : 'text-slate-700 hover:bg-slate-50'
      }`}
    >
      <Icone className={`size-4 ${danger ? 'text-red-500' : 'text-slate-400'}`} />
      <span className="font-medium">{label}</span>
    </button>
  )
}

/* ============================================================
   Bulle d'un message
   ============================================================ */
function Bulle({ m, moi, conversation, onRepondre, onModifier, onSupprimer, onReagir, onOuvrirEmoji }) {
  const autres = conversation.participants.length - 1
  const statut =
    m.nb_lecteurs === 0
      ? 'Envoyé'
      : conversation.type === 'DIRECT'
        ? 'Lu'
        : `Lu par ${m.nb_lecteurs}/${autres}`

  const [menuOuvert, setMenuOuvert] = useState(false)
  const [barreVisible, setBarreVisible] = useState(false)
  const [positionBarre, setPositionBarre] = useState('above')

  const bulleRef = useRef(null)

  function surSurvol() {
    if (bulleRef.current) {
      const rect = bulleRef.current.getBoundingClientRect()
      const ESPACE_REQUIS = 380
      setPositionBarre(rect.top >= ESPACE_REQUIS ? 'above' : 'below')
    }
    setBarreVisible(true)
  }

  function surSortie() {
    setBarreVisible(false)
  }

  const alignement = moi ? 'right' : 'left'

  return (
    <div className={`group flex items-end gap-2 ${moi ? 'justify-end' : 'justify-start'}`}>
      {/* Bouton ⋯ */}
      <div
        className={`flex shrink-0 items-center transition-opacity duration-150 ${
          menuOuvert ? 'opacity-100' : 'opacity-0 group-hover:opacity-100'
        } ${moi ? 'order-1' : 'order-2'}`}
      >
        <button
          type="button"
          onClick={() => setMenuOuvert(!menuOuvert)}
          className="flex size-8 items-center justify-center rounded-full bg-white text-slate-500 shadow-sm ring-1 ring-slate-200 hover:bg-slate-100 hover:text-slate-700 hover:ring-slate-300 transition-all"
          aria-label="Options"
        >
          <MoreHorizontal className="size-4" />
        </button>
      </div>

      {/* Wrapper bulle */}
      <div
        ref={bulleRef}
        className={`relative max-w-[75%] md:max-w-[60%] ${moi ? 'order-2' : 'order-1'}`}
        onMouseEnter={surSurvol}
        onMouseLeave={surSortie}
      >
        {/* Barre de réactions rapides */}
        <AnimatePresence>
          {barreVisible && !menuOuvert && (
            <BarreReactions
              onReagir={(emoji, ouvrirPicker) => {
                if (ouvrirPicker) {
                  onOuvrirEmoji?.(m)
                } else {
                  onReagir?.(m, emoji)
                }
                setBarreVisible(false)
              }}
              position={positionBarre}
              align={alignement}
            />
          )}
        </AnimatePresence>

        {/* Bulle */}
        <div
          onContextMenu={(e) => { e.preventDefault(); setMenuOuvert(true) }}
          className={`rounded-2xl px-4 py-2.5 shadow-sm ring-1 transition-shadow hover:shadow-md ${
            moi
              ? 'rounded-br-md bg-blue-600 text-white ring-blue-500/20'
              : 'rounded-bl-md bg-white text-slate-800 ring-slate-200'
          }`}
        >
          {!moi && conversation.type !== 'DIRECT' && (
            <p className="mb-1 text-xs font-semibold text-blue-600">
              {m.expediteur?.prenom} {m.expediteur?.nom}
            </p>
          )}

          {m.reponse_a && (
            <div className={`mb-2 rounded-lg border-l-2 px-2.5 py-1.5 text-xs ${
              moi ? 'border-blue-300 bg-blue-700/40' : 'border-blue-500 bg-slate-100'
            }`}>
              <p className={`text-[10px] font-bold uppercase tracking-wider ${moi ? 'text-blue-200' : 'text-blue-600'}`}>
                {m.reponse_a.expediteur}
              </p>
              <p className={`mt-0.5 truncate ${moi ? 'text-blue-100' : 'text-slate-600'}`}>
                {m.reponse_a.apercu}
              </p>
            </div>
          )}

          {m.contenu && (
            <p className="whitespace-pre-wrap break-words text-sm leading-relaxed">{m.contenu}</p>
          )}

          {m.fichiers.length > 0 && (
            <ul className="mt-2 space-y-1.5">
              {m.fichiers.map((f) => (
                <li key={f.reference_fichier}>
                  <a
                    href={`/api/fichiers/${f.reference_fichier}`}
                    download
                    className={`flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-sm transition ${
                      moi ? 'bg-blue-700/50 hover:bg-blue-700' : 'border border-slate-200 bg-slate-50 hover:bg-slate-100'
                    }`}
                  >
                    <span className={`flex size-8 shrink-0 items-center justify-center rounded-md ${
                      moi ? 'bg-blue-600 text-white' : 'bg-white text-slate-500 ring-1 ring-slate-200'
                    }`}>
                      <Paperclip className="size-4" />
                    </span>
                    <span className="min-w-0 flex-1">
                      <span className="block truncate font-medium">{f.nom_original}</span>
                      <span className={`block text-xs ${moi ? 'text-blue-100' : 'text-slate-500'}`}>
                        {tailleLisible(f.taille)}
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          )}

          {/* Métadonnées (heure + statut) — CONTRASTE AMÉLIORÉ */}
          <div className={`mt-1.5 flex items-center justify-end gap-1.5 text-[10px] ${
            moi ? 'text-blue-100' : 'text-slate-600'
          }`}>
            <span>{heureSeule(m.date_envoi)}{m.date_modification && ' · modifié'}</span>
            {moi && (
              <span className="flex items-center gap-0.5">
                {m.nb_lecteurs > 0 ? <CheckCheck className="size-3.5" /> : <Check className="size-3.5" />}
                <span>{statut}</span>
              </span>
            )}
          </div>
        </div>

        {/* Réactions */}
        <ReactionsAffichees
          reactions={m.reactions || []}
          moi={moi}
          onToggle={(emoji) => onReagir?.(m, emoji)}
        />

        {/* Menu contextuel */}
        <AnimatePresence>
          {menuOuvert && (
            <MenuMessage
              moi={moi}
              onRepondre={() => onRepondre(m)}
              onModifier={() => onModifier(m)}
              onSupprimer={() => onSupprimer(m)}
              onFermer={() => setMenuOuvert(false)}
            />
          )}
        </AnimatePresence>
      </div>
    </div>
  )
}

/* ============================================================
   Composant principal
   ============================================================ */
export default function Discussion({ conversation, onLu, onRetour }) {
  const { utilisateur } = useAuth()
  const ref = conversation.reference_conversation

  const [messages, setMessages] = useState([])
  const [peutPlus, setPeutPlus] = useState(false)
  const [texte, setTexte] = useState('')
  const [fichiers, setFichiers] = useState([])
  const [reponseA, setReponseA] = useState(null)
  const [edition, setEdition] = useState(null)
  const [envoi, setEnvoi] = useState(false)
  const [erreur, setErreur] = useState('')

  // ✅ État pour le picker global (ouvert depuis la barre de réaction)
  const [pickerPour, setPickerPour] = useState(null) // message pour lequel le picker est ouvert
  const [pickerPosition, setPickerPosition] = useState('above')
  const [pickerAlign, setPickerAlign] = useState('left')

  const zone = useRef(null)
  const coller = useRef(true)
  const premiere = useRef(true)

  const peutEcrire =
    conversation.type !== 'DIFFUSION' ||
    conversation.matricule_createur === utilisateur.matricule

  const charger = useCallback(async () => {
    try {
      const { data } = await api.get(`/api/conversations/${ref}/messages`)
      // ✅ Trier par date croissante (plus ancien en haut)
      const tries = [...(data.messages || [])].sort((a, b) => {
        const dateA = new Date(a.date_envoi).getTime()
        const dateB = new Date(b.date_envoi).getTime()
        if (dateA !== dateB) return dateA - dateB
        return a.reference_message - b.reference_message
      })
      setMessages((actuels) => fusionner(actuels, tries))
      if (premiere.current) {
        setPeutPlus(data.peut_charger_plus)
        premiere.current = false
      }

      const nonLus = tries.some((m) => !m.lu_par_moi && m.expediteur?.matricule !== utilisateur.matricule)
      if (nonLus && !document.hidden) {
        await api.post(`/api/conversations/${ref}/lu`)
        onLu?.()
      }
    } catch {
      // erreur réseau ponctuelle
    }
  }, [ref, utilisateur.matricule, onLu])

  usePolling(charger, 3000)

  useEffect(() => {
    const el = zone.current
    if (el && coller.current) el.scrollTop = el.scrollHeight
  }, [messages])

  function surDefilement() {
    const el = zone.current
    coller.current = el.scrollHeight - el.scrollTop - el.clientHeight < 80
  }

  async function chargerPlus() {
    try {
      const { data } = await api.get(`/api/conversations/${ref}/messages`, {
        params: { avant: messages[0].reference_message },
      })
      const tries = [...(data.messages || [])].sort((a, b) => {
        const dateA = new Date(a.date_envoi).getTime()
        const dateB = new Date(b.date_envoi).getTime()
        return dateA - dateB
      })
      setMessages((actuels) => [...tries, ...actuels])
      setPeutPlus(data.peut_charger_plus)
    } catch (e) {
      setErreur(messageErreur(e))
    }
  }

  function ajouterFichiers(e) {
    const choisis = Array.from(e.target.files)
    e.target.value = ''
    const total = [...fichiers, ...choisis]
    if (total.length > MAX_FICHIERS) {
      setErreur(`${MAX_FICHIERS} fichiers maximum par message.`)
      return
    }
    const trop = total.find((f) => f.size > MAX_OCTETS)
    if (trop) {
      setErreur(`${trop.name} dépasse 10 Mo.`)
      return
    }
    setErreur('')
    setFichiers(total)
  }

  async function envoyer() {
    const contenu = texte.trim()
    if (edition && !contenu) {
      setErreur('Le message ne peut pas être vide.')
      return
    }
    if (!contenu && fichiers.length === 0) return

    setEnvoi(true)
    setErreur('')
    try {
      if (edition) {
        await api.patch(`/api/messages/${edition.reference_message}`, { contenu })
        setEdition(null)
      } else {
        const donnees = new FormData()
        if (contenu) donnees.append('contenu', contenu)
        if (reponseA) donnees.append('reference_message_parent', reponseA.reference_message)
        fichiers.forEach((f) => donnees.append('fichiers[]', f))
        await api.post(`/api/conversations/${ref}/messages`, donnees)
        setFichiers([])
        setReponseA(null)
      }
      setTexte('')
      coller.current = true
      await charger()
      onLu?.()
    } catch (e) {
      setErreur(messageErreur(e))
    } finally {
      setEnvoi(false)
    }
  }

  async function supprimer(m) {
    if (!window.confirm('Supprimer ce message ?')) return
    try {
      setMessages((actuels) => actuels.filter((x) => x.reference_message !== m.reference_message))
      await api.delete(`/api/messages/${m.reference_message}`)
      await charger()
    } catch (e) {
      setErreur(messageErreur(e))
      await charger()
    }
  }

  function modifier(m) {
    setEdition(m)
    setReponseA(null)
    setFichiers([])
    setTexte(m.contenu ?? '')
  }

  function reagir(m, emoji) {
    setMessages((actuels) =>
      actuels.map((msg) => {
        if (msg.reference_message !== m.reference_message) return msg
        const reactions = [...(msg.reactions || [])]
        const idx = reactions.findIndex((r) => r.emoji === emoji)

        if (idx >= 0) {
          const r = reactions[idx]
          if (r.moi) {
            if (r.nb === 1) reactions.splice(idx, 1)
            else reactions[idx] = { ...r, nb: r.nb - 1, moi: false }
          } else {
            reactions[idx] = { ...r, nb: r.nb + 1, moi: true }
          }
        } else {
          const mesReactions = reactions.filter((r) => r.moi)
          if (mesReactions.length >= MAX_REACTIONS_PAR_USER) {
            const idxPlusAncienne = reactions.findIndex((r) => r.moi)
            if (idxPlusAncienne >= 0) {
              const ancienne = reactions[idxPlusAncienne]
              if (ancienne.nb === 1) reactions.splice(idxPlusAncienne, 1)
              else reactions[idxPlusAncienne] = { ...ancienne, nb: ancienne.nb - 1, moi: false }
            }
          }
          reactions.push({ emoji, nb: 1, moi: true })
        }
        return { ...msg, reactions }
      })
    )

    api.post(`/api/messages/${m.reference_message}/reactions`, { emoji })
      .then(({ data }) => {
        setMessages((actuels) =>
          actuels.map((msg) =>
            msg.reference_message === m.reference_message
              ? { ...msg, reactions: data.reactions }
              : msg
          )
        )
      })
      .catch(() => charger())
  }

  // ✅ Ouvre le picker depuis la barre de réactions
  function ouvrirPickerEmoji(m) {
    // Détecte la position et l'alignement
    const moi = m.expediteur?.matricule === utilisateur.matricule
    // Position : on regarde la position actuelle dans la liste
    const index = messages.findIndex((x) => x.reference_message === m.reference_message)
    const estEnBas = index > messages.length - 3 // 3 derniers messages
    setPickerPosition(estEnBas ? 'above' : 'above')
    setPickerAlign(moi ? 'right' : 'left')
    setPickerPour(m)
  }

  function annulerContexte() {
    setEdition(null)
    setReponseA(null)
    setTexte('')
  }

  function surTouche(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault()
      envoyer()
    }
  }

  const autre = conversation.participants.find((p) => p.matricule !== utilisateur.matricule)
  const sousTitre =
    conversation.type === 'DIRECT'
      ? autre?.poste
      : `${conversation.participants.length} participants · ${conversation.participants.map((p) => p.prenom).join(', ')}`

  // ✅ Regroupement par jour
  let jourPrecedent = ''

  return (
    <div className="flex h-full min-h-0 flex-col bg-slate-50">
      {/* ===== Header ===== */}
      <header className="flex items-center gap-3 border-b border-slate-200 bg-white px-5 py-3.5 shadow-sm">
        <button className="rounded-lg p-1.5 text-slate-600 hover:bg-slate-100 md:hidden" onClick={onRetour} aria-label="Retour">
          <ArrowLeft className="size-5" />
        </button>

        {conversation.type === 'DIRECT' && autre?.matricule ? (
          <Link to={`/utilisateurs/${autre.matricule}`} className="flex items-center gap-3 min-w-0 flex-1 rounded-lg -mx-2 px-2 py-1 hover:bg-slate-50 transition">
            <Avatar prenom={autre.prenom} nom={autre.nom} photoUrl={autre.photo_url} />
            <div className="min-w-0">
              <h2 className="truncate font-semibold text-slate-900">{conversation.titre}</h2>
              {sousTitre && <p className="truncate text-xs text-slate-500">{sousTitre}</p>}
            </div>
          </Link>
        ) : (
          <>
            <Avatar prenom={conversation.titre} nom="" />
            <div className="min-w-0">
              <h2 className="truncate font-semibold text-slate-900">{conversation.titre}</h2>
              {sousTitre && <p className="truncate text-xs text-slate-500">{sousTitre}</p>}
            </div>
          </>
        )}
      </header>

      {/* ===== Zone des messages ===== */}
      <div
        className="flex min-h-0 flex-1 flex-col gap-3 overflow-y-auto px-4 py-6 md:px-6"
        ref={zone}
        onScroll={surDefilement}
      >
        {peutPlus && (
          <Bouton className="self-center text-xs" onClick={chargerPlus}>
            Charger les messages précédents
          </Bouton>
        )}
        {messages.length === 0 && (
          <p className="py-10 text-center text-sm text-slate-500">Aucun message. Écrivez le premier !</p>
        )}

        <AnimatePresence mode="popLayout" initial={false}>
          {messages.map((m) => {
            const jour = new Date(m.date_envoi).toDateString()
            const nouveauJour = jour !== jourPrecedent
            jourPrecedent = jour
            return (
              <Fragment key={m.reference_message}>
                {nouveauJour && (
                  <motion.div
                    initial={{ opacity: 0 }}
                    animate={{ opacity: 1 }}
                    className="my-2 self-center rounded-full bg-slate-200 px-3 py-1 text-xs font-medium text-slate-600"
                  >
                    {libelleJour(m.date_envoi)}
                  </motion.div>
                )}
                <BulleAnimee>
                  <Bulle
                    m={m}
                    moi={m.expediteur?.matricule === utilisateur.matricule}
                    conversation={conversation}
                    onRepondre={(msg) => { setEdition(null); setReponseA(msg) }}
                    onModifier={modifier}
                    onSupprimer={supprimer}
                    onReagir={reagir}
                    onOuvrirEmoji={ouvrirPickerEmoji}
                  />
                </BulleAnimee>
              </Fragment>
            )
          })}
        </AnimatePresence>
      </div>

      {/* ===== Picker global (ouvert depuis la barre) ===== */}
      {pickerPour && (
        <div className="fixed inset-0 z-40" onClick={() => setPickerPour(null)}>
          <div
            className="absolute"
            style={{
              bottom: '80px',
              right: pickerAlign === 'right' ? '16px' : 'auto',
              left: pickerAlign === 'left' ? '16px' : 'auto',
            }}
            onClick={(e) => e.stopPropagation()}
          >
            <EmojiPicker
              onSelection={(emoji) => {
                reagir(pickerPour, emoji)
                setPickerPour(null)
              }}
              onFermer={() => setPickerPour(null)}
              positionPreferee="top"
              align={pickerAlign}
            />
          </div>
        </div>
      )}

      {/* ===== Footer (une seule ligne) ===== */}
      {peutEcrire ? (
        <footer className="border-t border-slate-200 bg-white px-3 py-2.5">
          {(reponseA || edition) && (
            <div className="mb-2 flex items-center justify-between gap-2 rounded-lg border-l-4 border-blue-500 bg-slate-100 px-3 py-1.5 text-sm text-slate-700">
              <span className="truncate">
                {edition
                  ? 'Modification du message'
                  : `Réponse à ${reponseA.expediteur?.prenom ?? ''} : ${(reponseA.contenu ?? 'pièce jointe').slice(0, 60)}`}
              </span>
              <button onClick={annulerContexte} aria-label="Annuler"><X className="size-4" /></button>
            </div>
          )}

          {fichiers.length > 0 && (
            <div className="mb-2 flex flex-wrap gap-2">
              {fichiers.map((f, i) => (
                <button
                  key={`${f.name}-${i}`}
                  onClick={() => setFichiers(fichiers.filter((_, j) => j !== i))}
                  className="flex items-center gap-1.5 rounded-full border border-slate-300 bg-slate-50 px-3 py-1 text-xs hover:bg-slate-100"
                >
                  <Paperclip className="size-3.5" />
                  {f.name} ({tailleLisible(f.size)})
                  <X className="size-3.5" />
                </button>
              ))}
            </div>
          )}

          {erreur && <p className="mb-2 text-sm text-red-600" role="alert">{erreur}</p>}

          {/* ✅ Une seule ligne : 📎 + textarea + Envoyer */}
          <div className="flex items-center gap-2">
            {!edition && (
              <label
                className="flex size-10 shrink-0 cursor-pointer items-center justify-center rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-50 transition"
                title="Joindre un fichier"
              >
                <Paperclip className="size-5" />
                <span className="sr-only">Joindre un fichier</span>
                <input type="file" multiple accept={TYPES_ACCEPTES} onChange={ajouterFichiers} hidden />
              </label>
            )}
            <textarea
              value={texte}
              onChange={(e) => setTexte(e.target.value)}
              onKeyDown={surTouche}
              placeholder="Écrivez un message... (Entrée pour envoyer, Maj+Entrée pour aller à la ligne)"
              rows={1}
              maxLength={5000}
              className="max-h-32 min-h-10 flex-1 resize-none rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-700 placeholder-slate-500
                         focus-visible:outline-2 focus-visible:outline-blue-600"
            />
            <Bouton variante="primaire" className="h-10 shrink-0" onClick={envoyer} disabled={envoi}>
              <SendHorizontal className="size-4" />
              {edition ? 'Enregistrer' : 'Envoyer'}
            </Bouton>
          </div>
        </footer>
      ) : (
        <footer className="border-t border-slate-200 bg-white p-4 text-center text-sm text-slate-600">
          Diffusion : seul le créateur peut écrire dans cette conversation.
        </footer>
      )}
    </div>
  )
}
