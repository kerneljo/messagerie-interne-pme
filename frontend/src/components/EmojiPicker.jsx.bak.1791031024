  },
]

const HAUTEUR_PICKER = 380

export default function EmojiPicker({ onSelection, onFermer, positionPreferee = 'top', align = 'left' }) {
  const [position, setPosition] = useState(positionPreferee)
  const ref = useRef(null)
  const mesuree = useRef(false)

  // ✅ Mesure la VRAIE position une seule fois, après le premier paint
  useLayoutEffect(() => {
    if (mesuree.current || !ref.current) return

    const rect = ref.current.getBoundingClientRect()
    const espaceAuDessus = rect.top
    const espaceEnDessous = window.innerHeight - rect.bottom

    // Le picker est actuellement positionné selon `positionPreferee`
    // On regarde si la position préférée est valide
    if (positionPreferee === 'top' && espaceAuDessus < 0) {
      // Le picker dépasse en haut → bascule en bas
      setPosition('bottom')
    } else if (positionPreferee === 'bottom' && espaceEnDessous < 0) {
      // Le picker dépasse en bas → bascule en haut
      setPosition('top')
    }
    // Sinon on garde la position préférée

    mesuree.current = true
  }, [positionPreferee])

  // Fermeture au clic extérieur
  useEffect(() => {
    const handler = (e) => {
      if (ref.current && !ref.current.contains(e.target)) {
        onFermer()
      }
    }
    document.addEventListener('mousedown', handler)
    return () => document.removeEventListener('mousedown', handler)
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [])

  const enHaut = position === 'top'

  return (
    <div
      ref={ref}
      className={`w-[340px] rounded-2xl overflow-hidden flex flex-col ${
        enHaut ? 'absolute bottom-full mb-2' : 'absolute top-full mt-2'
      } ${align === 'right' ? 'right-0' : 'left-0'} z-50`}
      style={{
        height: `${HAUTEUR_PICKER}px`,
        boxShadow: '0 20px 40px -12px rgba(15, 23, 42, 0.15), 0 0 0 1px rgba(15, 23, 42, 0.06)',
      }}
    >
      {/* Header */}
      <div className="flex items-center justify-between border-b border-slate-100 bg-slate-50/80 px-3.5 py-2.5">
        <span className="text-[10px] font-bold uppercase tracking-widest text-slate-400">
          Emojis
        </span>
        <button
          type="button"
          onClick={onFermer}
          className="flex size-6 items-center justify-center rounded-md text-slate-400 hover:bg-slate-200 hover:text-slate-700 transition"
          aria-label="Fermer"
        >
          <svg className="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2.5">
            <path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      {/* Liste */}
      <div className="flex-1 overflow-y-auto bg-white px-3 py-2" style={{ overscrollBehavior: 'contain' }}>
        {CATEGORIES.map((cat, idx) => (
          <div key={cat.id} className={idx > 0 ? 'mt-4' : ''}>
            <h4 className="mb-2 text-[10px] font-bold uppercase tracking-widest text-slate-400">
              {cat.nom}
            </h4>
            <div className="grid grid-cols-8 gap-0.5">
              {cat.emojis.map((emoji, i) => (
                <button
                  key={`${cat.id}-${emoji}-${i}`}
                  type="button"
                  onMouseDown={(e) => e.preventDefault()}
                  onClick={() => {
                    onSelection(emoji)
                    onFermer()
                  }}
                  className="flex size-9 items-center justify-center rounded-lg text-xl
                             hover:bg-slate-100 hover:scale-110 active:scale-95 transition-all"
                >
                  {emoji}
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  )
}
